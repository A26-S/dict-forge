{
  "name": "dict-forge-frontend",
  "version": "1.0.0",
  "description": "Dictionary Forge - Desktop Application",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
